    // { PAD_CHUVA,    8.0f,    0.25f,     1.0f },   // chuva leve
    // { PAD_CHUVA,    8.0f,    0.40f,     2.0f },   // chuva pesada
     { PAD_CIRCULO,  8.0f,    2.0f,      1.0f },   // circulo do jevil
